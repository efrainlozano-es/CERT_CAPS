namespace training.workshop;

//definir tipo de datos - tipado con letra capital
type PriorityLevel : String enum {
    Standard = 'S';
    Express = 'E';
    Critical = 'C';
};

type OrderStatus   : String enum {
    Open = 'OPEN';
    InProgress = 'PROG';
    Closed = 'DONE';
};

//definiendo entidad - siempre en plural
entity Technicians {
    key ID         : UUID;
        name       : String;
        speciality : String;
};

entity ServiceOrders {
    key ID                 : UUID;
        customer           : String;
        priority           : PriorityLevel;
        status             : OrderStatus default 'OPEN';
        technician         : Association to Technicians; //technicians ($expand) and technicians_ID ($select) are automatucally generated by CDS //technicians_ID : UUID
        virtual totalHours : Decimal(6, 2);
        virtual laborCost  : Decimal(6, 2);
        tasks              : Composition of many Tasks
                                 on tasks.parent = $self; //asociation de 1 a muchos

};

entity Tasks {
    key ID          : UUID;
        description : String        @mandatory;
        hours       : Decimal(4, 2) @assert.range: [
            0.5,
            24
        ];
        parent      : Association to ServiceOrders; //parent ($expand) and parent_ID ($select) are automatucally generated by CDS //serviceorders_ID : UUID
}
